{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fei-skills.local/schemas/infographic-render-brief.schema.json",
  "title": "Fei Infographic Render Brief",
  "type": "object",
  "required": ["title", "goal", "audience", "aspect_ratio", "profile", "hero", "sections", "exact_strings", "visual", "qa"],
  "properties": {
    "title": {"type": "string", "minLength": 1},
    "goal": {"type": "string", "minLength": 1},
    "audience": {"type": "string", "minLength": 1},
    "aspect_ratio": {"type": "string", "pattern": "^[0-9]+:[0-9]+$"},
    "profile": {"enum": ["beginner-onboarding", "technical-architecture", "knowledge-explainer", "data-comparison", "process-guide"]},
    "hero": {
      "type": "object",
      "required": ["message", "visual_subject"],
      "properties": {
        "message": {"type": "string", "minLength": 1},
        "visual_subject": {"type": "string", "minLength": 1}
      }
    },
    "sections": {
      "type": "array",
      "minItems": 3,
      "maxItems": 10,
      "items": {
        "type": "object",
        "required": ["heading", "purpose", "content"],
        "properties": {
          "heading": {"type": "string", "minLength": 1},
          "purpose": {"enum": ["orient", "explain", "act", "evidence", "output", "boundary", "next-step"]},
          "content": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "exact_strings": {"type": "array", "items": {"type": "string"}},
    "prohibited_strings": {"type": "array", "items": {"type": "string"}},
    "visual": {
      "type": "object",
      "required": ["style_profile", "palette", "composition", "illustration_language"],
      "properties": {
        "style_profile": {"type": "string"},
        "palette": {"type": "array", "minItems": 2, "items": {"type": "string"}},
        "composition": {"type": "string", "minLength": 1},
        "illustration_language": {"type": "string", "minLength": 1}
      }
    },
    "source_notes": {"type": "array", "items": {"type": "string"}},
    "qa": {
      "type": "object",
      "required": ["three_second_read", "ten_second_path", "mobile_legibility", "fact_check", "tone_check"],
      "properties": {
        "three_second_read": {"type": "string"},
        "ten_second_path": {"type": "string"},
        "mobile_legibility": {"type": "string"},
        "fact_check": {"type": "string"},
        "tone_check": {"type": "string"}
      }
    }
  },
  "additionalProperties": true
}
