{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://fei-skills.local/schemas/explainer-scene-graph.json",
  "title":"Fei Knowledge Explainer Scene Graph",
  "type":"object",
  "required":["version","title","audience","chapters"],
  "properties":{
    "version":{"const":"0.3"},
    "title":{"type":"string","minLength":1},
    "audience":{"type":"string","minLength":1},
    "profile":{"type":"string","default":"song-aesthetic"},
    "learning_objective":{"type":"string"},
    "chapters":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/chapter"}}
  },
  "additionalProperties":false,
  "$defs":{
    "chapter":{"type":"object","required":["id","title","scenes"],"properties":{"id":{"type":"string"},"title":{"type":"string"},"scenes":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/scene"}}},"additionalProperties":false},
    "scene":{"type":"object","required":["id","title","summary","kind"],"properties":{"id":{"type":"string"},"title":{"type":"string"},"summary":{"type":"string"},"kind":{"enum":["text","flow","compare","network","chart","spatial"]},"narration":{"type":"string"},"fallback":{"type":"string"},"data":{"type":"object"}},"additionalProperties":false}
  }
}