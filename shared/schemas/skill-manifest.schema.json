{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fei-skills.local/schemas/skill-manifest.schema.json",
  "title": "Fei Skill Manifest",
  "type": "object",
  "required": ["id", "name", "version", "domain", "status", "description", "entrypoint", "inputs", "outputs", "runtime", "tags"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "name": {"type": "string", "minLength": 1},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "domain": {"enum": ["video", "web", "image", "visual-storytelling", "shared"]},
    "status": {"enum": ["draft", "workflow", "runnable", "stable"]},
    "description": {"type": "string", "minLength": 1},
    "entrypoint": {"type": "string"},
    "inputs": {"type": "array", "items": {"type": "string"}},
    "outputs": {"type": "array", "items": {"type": "string"}},
    "runtime": {"type": "array", "items": {"type": "string"}},
    "tags": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
