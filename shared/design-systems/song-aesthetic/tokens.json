{
  "version": "1.0.0",
  "colors": {
    "paper": "#F4F1E8",
    "paperDeep": "#ECE8DC",
    "ink": "#24302B",
    "inkSoft": "#5F6B65",
    "songGreen": "#7F9488",
    "songCyan": "#A7B8B1",
    "mist": "#D9DFDA",
    "line": "#C7CEC8",
    "white": "#FBFAF6"
  },
  "typography": {
    "display": "Songti SC, STSong, Noto Serif CJK SC, Georgia, serif",
    "body": "Songti SC, STSong, Noto Serif CJK SC, system-ui, sans-serif",
    "displayWeight": 500,
    "bodyWeight": 400
  },
  "motion": {
    "fastMs": 420,
    "baseMs": 620,
    "slowMs": 900,
    "preferredTransitions": ["dissolve", "paper-fade", "line-wipe", "slow-push"],
    "forbidden": ["bounce", "spin", "neon-glow", "dramatic-scale"]
  },
  "line": {
    "hairline": 1,
    "emphasis": 1.5
  },
  "spatial": {
    "material": "matte",
    "camera": "slow-single-axis",
    "background": "paper",
    "requireFallback": true
  }
}
